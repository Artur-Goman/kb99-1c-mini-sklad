&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Пытаемся получить отбор из параметров
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("ТипКонтрагента") Тогда
		
		МассивТипов = Параметры.Отбор.ТипКонтрагента;
		
		// Очищаем текущие отборы списка
		Элементы.Список.Отбор.Элементы.Очистить();
		
		// Устанавливаем отбор "В списке"
		ЭлементОтбора = Элементы.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораДинамическогоСписка"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипКонтрагента");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = МассивТипов;
		
	КонецЕсли;
	
КонецПроцедуры