Функция ПолучитьТипыПоставщиков() Экспорт
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Перечисления.ТипКонтрагента.ЭтоПоставщик);
	МассивТипов.Добавить(Перечисления.ТипКонтрагента.ПоставщикИПокупатель);
	
	Возврат МассивТипов;
	
КонецФункции

Функция ПолучитьТипыПокупателей() Экспорт
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Перечисления.ТипКонтрагента.ЭтоПокупатель);
	МассивТипов.Добавить(Перечисления.ТипКонтрагента.ПоставщикИПокупатель);
	
	Возврат МассивТипов;
	
КонецФункции