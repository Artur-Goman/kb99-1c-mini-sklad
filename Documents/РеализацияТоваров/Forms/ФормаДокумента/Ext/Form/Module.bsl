#Область РасчетТабличнойЧасти

&НаКлиенте
Процедура ПродаваемыеТоварыЦенаПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ПродаваемыеТовары.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПродаваемыеТоварыКоличествоПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ПродаваемыеТовары.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПродаваемыеТоварыСуммаПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ПродаваемыеТовары.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		Если ТекущаяСтрока.Количество <> 0 Тогда
			ТекущаяСтрока.Цена = ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество;
			// Пересчитываем сумму обратно для устранения ошибок округления
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
		Иначе
			ТекущаяСтрока.Цена = 0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ВыборКонтрагента 

&НаКлиенте
Процедура ПокупательНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МассивТипов = ОбщегоНазначенияСервер.ПолучитьТипыПокупателей();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТипКонтрагента", МассивТипов);
	
	ПараметрыФормы = Новый Структура("Отбор", ПараметрыОтбора);
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродаваемыеТоварыТоварОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
    
    // Проверяем, что выбрана именно ссылка на товар
    Если ТипЗнч(ВыбранноеЗначение) <> Тип("СправочникСсылка.Товары") Тогда
        Возврат;
    КонецЕсли;
    
    ТекущаяСтрока = Элементы.ПродаваемыеТовары.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Вызываем серверную функцию и записываем результат в реквизит ЕдИзм
    ТекущаяСтрока.ЕдИзм = ПолучитьЕдиницуИзмеренияТовара(ВыбранноеЗначение);
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЕдиницуИзмеренияТовара(ТоварСсылка)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения
        |ИЗ
        |    Справочник.Товары КАК Товары
        |ГДЕ
        |    Товары.Ссылка = &Товар";
    
    Запрос.УстановитьПараметр("Товар", ТоварСсылка);
    
    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    Возврат Выборка.ЕдиницаИзмерения;
    
КонецФункции

&НаКлиенте
Процедура ПродаваемыеТоварыПриИзменении(Элемент)
		// Пересчитываем общую сумму документа
	СуммаДокумента = 0;
	Для Каждого ТекСтрока Из Объект.ПродаваемыеТовары Цикл
		СуммаДокумента = СуммаДокумента + ТекСтрока.Сумма;
	КонецЦикла;
КонецПроцедуры
#КонецОбласти    

