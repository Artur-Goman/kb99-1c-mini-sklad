Процедура ОбработкаПроведения(Отказ, Режим)
	
	// 1. КОНТРОЛЬ ОСТАТКОВ (только при оперативном проведении)
	Если Режим = РежимПроведенияДокумента.Оперативный Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПродаваемыеТовары.Товар КАК Товар,
			|	СУММА(ПродаваемыеТовары.Количество) КАК Количество
			|ПОМЕСТИТЬ ВТ_ТоварыДокумента
			|ИЗ
			|	Документ.РеализацияТоваров.ПродаваемыеТовары КАК ПродаваемыеТовары
			|ГДЕ
			|	ПродаваемыеТовары.Ссылка = &Ссылка
			|СГРУППИРОВАТЬ ПО
			|	ПродаваемыеТовары.Товар
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТоварыДокумента.Товар КАК Товар,
			|	ТоварыДокумента.Количество КАК Количество,
			|	ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0) КАК Остаток
			|ИЗ
			|	ВТ_ТоварыДокумента КАК ТоварыДокумента
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
			|				&МоментВремени,
			|				Товар В (ВЫБРАТЬ Товар ИЗ ВТ_ТоварыДокумента)
			|			) КАК ОстаткиТоваровОстатки
			|		ПО ТоварыДокумента.Товар = ОстаткиТоваровОстатки.Товар
			|ГДЕ
			|	ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0) < ТоварыДокумента.Количество";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Включая));
		
		Результат = Запрос.Выполнить();
		
		// Если есть строки, где остатка не хватает — выводим сообщение и отменяем проведение
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Недостаточно товара на складе: " + Выборка.Товар + ". Требуется: " + Выборка.Количество + ", в наличии: " + Выборка.Остаток;
				Сообщение.Сообщить();
			КонецЦикла;
			Отказ = Истина;
			Возврат; // Прерываем проведение
		КонецЕсли;
		
	КонецЕсли;
	
	// 2. ДВИЖЕНИЯ ПО РЕГИСТРАМ
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОборотыТоваров.Записывать = Истина;
	
	Для Каждого ТекСтрокаПродаваемыеТовары Из ПродаваемыеТовары Цикл
		
		// Регистр ОстаткиТоваров (Расход)
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаПродаваемыеТовары.Товар;
		Движение.Количество = ТекСтрокаПродаваемыеТовары.Количество;
		
		// Регистр ОборотыТоваров
		Движение = Движения.ОборотыТоваров.Добавить();
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаПродаваемыеТовары.Товар;
		Движение.Количество = ТекСтрокаПродаваемыеТовары.Количество;
		
	КонецЦикла;   
	
		
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Пересчитываем сумму перед сохранением в БД
	СуммаДокумента = 0;
	Для Каждого ТекСтрока Из ПродаваемыеТовары Цикл
		СуммаДокумента = СуммаДокумента + ТекСтрока.Сумма;
	КонецЦикла;
	
КонецПроцедуры

