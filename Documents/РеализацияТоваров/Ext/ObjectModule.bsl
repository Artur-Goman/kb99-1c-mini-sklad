Процедура ОбработкаПроведения(Отказ, Режим)
	
	// 1. ПОЛУЧАЕМ ДАННЫЕ ОБ ОСТАТКАХ ПО ПАРТИЯМ (СОРТИРУЯ ПО ДАТЕ ПОСТУПЛЕНИЯ - FIFO)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПродаваемыеТовары.Товар КАК Товар,
		|	СУММА(ПродаваемыеТовары.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_ТоварыДокумента
		|ИЗ
		|	Документ.РеализацияТоваров.ПродаваемыеТовары КАК ПродаваемыеТовары
		|ГДЕ
		|	ПродаваемыеТовары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ПродаваемыеТовары.Товар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиТоваровОстатки.Товар КАК Товар,
		|	ОстаткиТоваровОстатки.Партия КАК Партия,
		|	ОстаткиТоваровОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(
		|			&МоментВремени,
		|			Товар В (ВЫБРАТЬ Товар ИЗ ВТ_ТоварыДокумента)
		|		) КАК ОстаткиТоваровОстатки
		|ГДЕ
		|	ОстаткиТоваровОстатки.КоличествоОстаток > 0
		|УПОРЯДОЧИТЬ ПО
		|	ОстаткиТоваровОстатки.Партия.Дата ВОЗР"; // Сортируем по дате поступления (старые первыми)
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	// 2. ФОРМИРУЕМ ДВИЖЕНИЯ (FIFO) И КОНТРОЛЬ ОСТАТКОВ
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОборотыТоваров.Записывать = Истина;
	
	// Создаем таблицу для быстрого поиска партий по товару
	ТаблицаПартий = Новый ТаблицаЗначений;
	ТаблицаПартий.Колонки.Добавить("Товар");
	ТаблицаПартий.Колонки.Добавить("Партия");
	ТаблицаПартий.Колонки.Добавить("Количество");
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаПартий.Добавить();
		НоваяСтрока.Товар = Выборка.Товар;
		НоваяСтрока.Партия = Выборка.Партия;
		НоваяСтрока.Количество = Выборка.Количество;
	КонецЦикла;
	
	Для Каждого ТекСтрокаПродаваемыеТовары Из ПродаваемыеТовары Цикл
		
		ОсталосьСписать = ТекСтрокаПродаваемыеТовары.Количество;
		
		// Находим все партии для текущего товара
		Отбор = Новый Структура("Товар", ТекСтрокаПродаваемыеТовары.Товар);
		НайденныеСтроки = ТаблицаПартий.НайтиСтроки(Отбор);
		
		Для Каждого СтрокаПартии Из НайденныеСтроки Цикл
			
			Если ОсталосьСписать <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			// Берем из партии либо столько, сколько нужно, либо столько, сколько есть
			Если СтрокаПартии.Количество >= ОсталосьСписать Тогда
				КоличествоИзПартии = ОсталосьСписать;
			Иначе
				КоличествоИзПартии = СтрокаПартии.Количество;
			КонецЕсли;
			
			// Записываем расход по регистру ОстаткиТоваров
			Движение = Движения.ОстаткиТоваров.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Товар = ТекСтрокаПродаваемыеТовары.Товар;
			Движение.Партия = СтрокаПартии.Партия; // Указываем конкретную партию!
			Движение.Количество = КоличествоИзПартии;
			
			// Записываем в регистр ОборотыТоваров
			ДвижениеОборот = Движения.ОборотыТоваров.Добавить();
			ДвижениеОборот.Период = Дата;
			ДвижениеОборот.Товар = ТекСтрокаПродаваемыеТовары.Товар;
			ДвижениеОборот.Количество = КоличествоИзПартии;
			
			// Уменьшаем количество к списанию
			ОсталосьСписать = ОсталосьСписать - КоличествоИзПартии;
			СтрокаПартии.Количество = СтрокаПартии.Количество - КоличествоИзПартии;
			
		КонецЦикла;
		
		// Если после прохода по всем партиям осталось несписанное количество — значит, не хватает товара
		Если ОсталосьСписать > 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Недостаточно товара на складе: " + ТекСтрокаПродаваемыеТовары.Товар + ". Не хватает: " + ОсталосьСписать;
			Сообщение.Сообщить();
			Отказ = Истина;
			Возврат; // Прерываем проведение
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры



Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Пересчитываем сумму перед сохранением в БД
	СуммаДокумента = 0;
	Для Каждого ТекСтрока Из ПродаваемыеТовары Цикл
		СуммаДокумента = СуммаДокумента + ТекСтрока.Сумма;
	КонецЦикла;
	
КонецПроцедуры

