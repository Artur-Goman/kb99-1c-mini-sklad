Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Пересчитываем сумму перед сохранением в БД
	СуммаДокумента = 0;
	Для Каждого ТекСтрока Из ПоступаемыеТовары Цикл
		СуммаДокумента = СуммаДокумента + ТекСтрока.Сумма;
