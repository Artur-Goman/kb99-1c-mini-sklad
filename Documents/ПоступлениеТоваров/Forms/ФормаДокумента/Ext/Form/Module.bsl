#Область РасчетТабличнойЧасти

&НаКлиенте
Процедура ПоступаемыеТоварыЦенаПриИзменении(Элемент)
	РассчитатьСуммуВСтроке();
КонецПроцедуры

&НаКлиенте
Процедура ПоступаемыеТоварыКоличествоПриИзменении(Элемент)
	РассчитатьСуммуВСтроке();
КонецПроцедуры

&НаКлиенте
Процедура ПоступаемыеТоварыСуммаПриИзменении(Элемент)
	// Логика обратная: рассчитываем цену исходя из введенной суммы.
	// Итоговая сумма пересчитывается в конце, чтобы избежать расхождений из-за округления.
	РассчитатьЦенуИзСуммы();
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуВСтроке()
	ТекущаяСтрока = Элементы.ПоступаемыеТовары.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЦенуИзСуммы()
	ТекущаяСтрока = Элементы.ПоступаемыеТовары.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		Если ТекущаяСтрока.Количество <> 0 Тогда
			ТекущаяСтрока.Цена = ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество;
			// Пересчитываем сумму обратно для устранения ошибок округления
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
		Иначе
			ТекущаяСтрока.Цена = 0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры  

#КонецОбласти


#Область ВыборКонтрагента 

&НаКлиенте
Процедура ПоставщикНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Вызываем функцию, которая выполнится на сервере и вернет массив
	МассивТипов = ПолучитьМассивТиповПоставщиков();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТипКонтрагента", МассивТипов);
	
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", Новый Структура("Отбор", ПараметрыОтбора), Элемент);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивТиповПоставщиков()
	
	МассивТипов = Новый Массив;
	// Используем точные имена из дерева конфигурации!
	МассивТипов.Добавить(Перечисления.ТипКонтрагента.ЭтоПоставщик);
	МассивТипов.Добавить(Перечисления.ТипКонтрагента.ПоставщикИПокупатель);
	
	Возврат МассивТипов;
	
КонецФункции  

#КонецОбласти